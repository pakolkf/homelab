APPDATA_DIR=/opt/homelab/appdata
MEDIA_DIR=/opt/homelab/data_arr

# Transmission
USER=changeme
PASS=changeme

# aMule
WEBUI_PWD=changeme
GUI_PWD=changeme
INCOMING_DIR=/data_arr/downloads/amule/completed
TEMP_DIR=/data_arr/downloads/amule/temp
# Mods de ngosang/amule
MOD_AUTO_RESTART_ENABLED=true
MOD_AUTO_RESTART_CRON=0 6 * * *
MOD_AUTO_SHARE_ENABLED=false
MOD_FIX_KAD_GRAPH_ENABLED=true
MOD_FIX_KAD_BOOTSTRAP_ENABLED=true

# Amutorrent
NODE_ENV=production
AMULE_ENABLED=true
AMULE_HOST=amule
AMULE_PORT=4712
AMULE_PASSWORD=changeme

QBITTORRENT_ENABLED=true
QBITTORRENT_HOST=qbittorrent
QBITTORRENT_PORT=8080
QBITTORRENT_USERNAME=changeme
QBITTORRENT_PASSWORD=changeme

TRANSMISSION_ENABLED=true
TRANSMISSION_HOST=transmission
TRANSMISSION_PORT=9091
TRANSMISSION_USERNAME=changeme
TRANSMISSION_PASSWORD=changeme

PROWLARR_ENABLED=true
PROWLARR_URL=http://prowlarr:9696
PROWLARR_API_KEY=changeme

RADARR_URL=http://radarr:7878
RADARR_API_KEY=changeme
RADARR_SEARCH_INTERVAL_HOURS=6

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=changeme
SONARR_SEARCH_INTERVAL_HOURS=6
