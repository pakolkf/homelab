# homarr — dashboard (lee el socket por socket-proxy-ro)
APPDATA_DIR=/opt/homelab/appdata/homarr
DOCKER_HOSTNAMES=socket-proxy-ro
DOCKER_PORTS=2375                      # puerto INTERNO del proxy (no 2376)
AUTH_TRUST_HOST=true
SECRET_ENCRYPTION_KEY=CHANGE_ME        # openssl rand -hex 32
AUTH_SECRET=CHANGE_ME                  # openssl rand -base64 32
