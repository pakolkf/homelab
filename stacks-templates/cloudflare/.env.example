# cloudflare — Tunnel (cloudflared) + companion. SIN volúmenes (no usa APPDATA_DIR).

# Túnel
TUNNEL_TOKEN=CHANGE_ME

# Companion (sincroniza CNAMEs de Traefik con Cloudflare)
CF_TOKEN=CHANGE_ME
TARGET_DOMAIN=example.com
DOMAINS=example.com
PROXIED=true
RC_TYPE=CNAME
REFRESH_ENTRIES=true
ENABLE_TRAEFIK_POLL=true
TRAEFIK_POLL_URL=http://traefik:8080
TRAEFIK_POLL_SECONDS=30
TRAEFIK_VERSION=2
DOCKER_HOST=tcp://socket-proxy-ro:2375
LOG_TYPE=both
LOG_LEVEL=INFO
UPDATE_CRON=
