APPDATA_DIR=/opt/homelab/appdata/sarr
MEDIA_DIR=/opt/homelab/data_arr

# ============================================================
# UNPACKERR
# ============================================================
UN_LOG_LEVEL=info
UN_PARALLEL=2

# Sonarr
UN_SONARR_0_URL=http://sonarr:8989
UN_SONARR_0_API_KEY=<api_key_sonarr>
UN_SONARR_0_PATHS_0=/data_arr/downloads
UN_SONARR_0_PROTOCOLS=torrent,usenet
UN_SONARR_0_TIMEOUT=10s
UN_SONARR_0_DELETE_DELAY=5m

# Radarr
UN_RADARR_0_URL=http://radarr:7878
UN_RADARR_0_API_KEY=<api_key_radarr>
UN_RADARR_0_PATHS_0=/data_arr/downloads
UN_RADARR_0_PROTOCOLS=torrent,usenet
UN_RADARR_0_TIMEOUT=10s
UN_RADARR_0_DELETE_DELAY=5m