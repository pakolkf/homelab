# socket-proxy-ro: SOLO LECTURA minima. La consumen Traefik, dozzle, beszel,
# cloudflare-companion y homarr. Ya NO existe variante read-write: hawser es
# el unico plano de escritura (token, monta el socket crudo).
LOG_LEVEL=info

# Endpoints permitidos (lectura minima)
PING=1
VERSION=1
EVENTS=1
CONTAINERS=1
NETWORKS=1

# Lectura sensible -> deshabilitada
INFO=0
IMAGES=0
VOLUMES=0
SYSTEM=0
TASKS=0
DISTRIBUTION=0
PLUGINS=0
SERVICES=0
NODES=0
CONFIGS=0
SESSION=0
SWARM=0
SECRETS=0
AUTH=0
EXEC=0

# Escritura -> deshabilitada
POST=0
BUILD=0
COMMIT=0
ALLOW_START=0
ALLOW_STOP=0
ALLOW_RESTARTS=0
ALLOW_PAUSE=0
ALLOW_UNPAUSE=0
