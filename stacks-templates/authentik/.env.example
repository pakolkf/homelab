# authentik — SSO / proveedor de identidad
APPDATA_DIR=/opt/homelab/appdata/authentik

# PostgreSQL
POSTGRES_DB=authentik
POSTGRES_USER=authentik
POSTGRES_PASSWORD=CHANGE_ME            # openssl rand 32 | base64 -w0

# Authentik
AUTHENTIK_POSTGRESQL__HOST=authentik-postgresql
AUTHENTIK_POSTGRESQL__NAME=authentik
AUTHENTIK_POSTGRESQL__USER=authentik
AUTHENTIK_POSTGRESQL__PASSWORD=CHANGE_ME   # = POSTGRES_PASSWORD
AUTHENTIK_SECRET_KEY=CHANGE_ME             # openssl rand 60 | base64 -w0
AUTHENTIK_ERROR_REPORTING__ENABLED=false
