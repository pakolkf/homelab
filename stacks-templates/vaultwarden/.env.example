# vaultwarden — gestor de contraseñas
APPDATA_DIR=/opt/homelab/appdata/vaultwarden
DOMAIN=https://vault.example.com
ADMIN_TOKEN=CHANGE_ME                  # hash argon2 (vaultwarden hash) — NO guardes el plano
SIGNUPS_ALLOWED=false
WEBSOCKET_ENABLED=true
ROCKET_PORT=80
LOG_LEVEL=warn
EXTENDED_LOGGING=true
