# =========================================================
# Secretos por stack
# =========================================================
# El docker/.env raíz SÍ se versiona (sólo defaults no sensibles).
# Los .env por stack NO se versionan, salvo excepciones explícitas.
docker/*/.env
stacks-templates/*/.env
docker/**/.env.local
stacks-templates/**/.env.local
*.env.local

# Excepción: el .env de socket-proxy no contiene secretos.
!stacks-templates/socket-proxy/.env

# =========================================================
# Runtime / datos persistentes de los stacks
# =========================================================
# Volúmenes y estado generados en tiempo de ejecución.
# Las recetas (docker-compose.yaml, *.yaml de config) sí se versionan.

# Genéricos (cubre la mayoría de stacks: appdata, data, config, logs, backups…)
docker/*/appdata/
docker/*/data/
docker/*/config/
docker/*/conf/
docker/*/logs/
docker/*/log/
docker/*/database/
docker/*/backups/
docker/*/work/
stacks-templates/*/appdata/
stacks-templates/*/data/
stacks-templates/*/config/
stacks-templates/*/conf/
stacks-templates/*/logs/
stacks-templates/*/log/
stacks-templates/*/database/
stacks-templates/*/backups/
stacks-templates/*/work/

# Específicos
stacks-templates/traefik/letsencrypt/
stacks-templates/traefik/logs/
stacks-templates/cloudflare/credentials/
stacks-templates/tailscale/data/
stacks-templates/tailscale/config/
stacks-templates/wgdashboard/conf/
stacks-templates/duplicati/backups/

# Unbound: las raíces se refrescan mensualmente por cron.
stacks-templates/unbound/root.hints
stacks-templates/unbound/root.key

# Traefik: NO ignorar `dynamic/` — es configuración versionada.
!stacks-templates/traefik/dynamic/

# =========================================================
# Material criptográfico y claves
# =========================================================
*.pem
*.key
*.crt
*.csr
id_rsa
id_rsa.pub
id_ed25519
id_ed25519.pub
acme*.json

# Excepciones: claves de configuración pública que sí se versionan
!stacks-templates/unbound/unbound.conf

# =========================================================
# Editor / SO
# =========================================================
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# =========================================================
# Backups y temporales
# =========================================================
*.bak
*.tmp
*.orig
*.log
